# Dataset source (public IBM Telco Customer Churn CSV)
DATASET_URL=https://raw.githubusercontent.com/IBM/telco-customer-churn-on-icp4d/master/data/Telco-Customer-Churn.csv

# Prefect orchestration (local server default; replace with Prefect Cloud values for cloud mode)
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_API_KEY=
PREFECT_WORK_POOL=telco-process-pool

# FastAPI and Streamlit dashboard
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
